# =============================================================================
# COAP API — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# =============================================================================

# App
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# Single tenant company ID (future: dynamic per request)
DEFAULT_COMPANY_ID=coap-default-company

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/coap_dev"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
JWT_SECRET=your-super-secret-jwt-key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=coap-documents
R2_PUBLIC_URL=https://documents.yourdomain.com

# AMEX / Plaid Integration
PLAID_CLIENT_ID=xxx
PLAID_SECRET=xxx
PLAID_ENV=sandbox

# Anthropic (AI Module)
ANTHROPIC_API_KEY=sk-ant-xxx

# Email (for vendor portal invites, invoice sending)
RESEND_API_KEY=re_xxx
FROM_EMAIL=noreply@yourdomain.com

# Electric SQL Sync
ELECTRIC_URL=http://localhost:5133
